{
  "name": "student-citations-mcp",
  "version": "0.1.4",
  "description": "Citation MCP server for AI apps. A citation generator that builds APA, MLA and Chicago citations from a DOI, an ISBN or typed details, with matching in text citations and entries for a works cited list. No account.",
  "type": "module",
  "main": "build/src/index.js",
  "bin": {
    "student-citations-mcp": "build/src/index.js"
  },
  "files": [
    "build/src",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/src/index.js', 0o755)\"",
    "test": "vitest run",
    "start": "node build/src/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "citation mcp",
    "citation generator",
    "cite this",
    "citations",
    "apa citation",
    "apa formatter",
    "mla citation",
    "mla formatter",
    "chicago citation",
    "chicago formatter",
    "doi to citation",
    "isbn citation",
    "mcp",
    "mcp server",
    "mcp-server",
    "model-context-protocol",
    "student",
    "students",
    "education",
    "edtech",
    "ai-agent",
    "claude",
    "chatgpt",
    "cursor",
    "apa",
    "mla",
    "chicago",
    "references",
    "reference list",
    "works cited",
    "bibliography",
    "in-text citation",
    "doi",
    "isbn",
    "crossref",
    "thesis",
    "dissertation"
  ],
  "author": "AnonymousOnyx22",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnonymousOnyx22/student-citations-mcp.git"
  },
  "homepage": "https://github.com/AnonymousOnyx22/student-citations-mcp#readme",
  "bugs": {
    "url": "https://github.com/AnonymousOnyx22/student-citations-mcp/issues"
  },
  "mcpName": "io.github.AnonymousOnyx22/student-citations-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
